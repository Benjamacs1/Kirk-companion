{
  "name": "kirk-companion",
  "version": "0.1.0",
  "description": "Open-source desktop bridge for launching your Minecraft instances from the Kirk website.",
  "author": "Benja",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Benjamacs1/Kirk-companion.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tools/ui-smoke.mjs",
    "pack": "electron-builder --dir",
    "source": "node tools/source.mjs",
    "dist": "electron-builder --win nsis --publish never && npm run source"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.61.0"
  },
  "build": {
    "appId": "uk.charlie-kirk.companion",
    "productName": "Kirk Companion",
    "asar": true,
    "files": [
      "src/**/*",
      "LICENSE",
      "README.md",
      "docs/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Kirk Companion",
        "schemes": [
          "kirk"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "src/ui/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  }
}
